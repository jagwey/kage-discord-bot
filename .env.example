# ========================================================
# ⛩️ KAGE 95 DISCORD BOTU - ALL-IN-ONE YAPILANDIRMASI
# ========================================================

# 1. Discord Bot Yetkilendirme Bilgileri
# https://discord.com/developers/applications adresinden temin ediniz
DISCORD_TOKEN=DISCORD_BOT_TOKENINIZ_BURAYA
CLIENT_ID=DISCORD_APPLICATION_CLIENT_ID_BURAYA
# Geliştirme aşamasında komutların anında yüklenmesi için opsiyonel sunucu ID'si:
GUILD_ID=

# 2. 🧠 Yapay Zeka (AI) Gölge Danışmanı Yapılandırması
# Hangi sağlayıcıyı kullanmak istersiniz? (gemini, claude veya oto)
AI_PROVIDER=gemini

# Google Gemini API Anahtarı (ÖNERİLEN - https://aistudio.google.com adresinden tamamen ücretsiz alınabilir):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API Anahtarı (Opsiyonel - https://console.anthropic.com adresinden temin edilir):
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Yetkililerin bot ile doğrudan doğal dilde konuşabileceği özel yönetim kanalı ID'si:
AI_ADMIN_CHANNEL_ID=

# 3. 🌐 Kage 95 Canlı Platform Bağlantıları
API_BASE_URL=https://kage95.com/api
SITE_URL=https://kage95.com

# 4. 📢 Otomatik Bölüm Duyuru Ayarları
# Yeni bölümlerin paylaşılacağı metin kanalı ID'si (örn. #yeni-bölümler):
ANNOUNCEMENT_CHANNEL_ID=
# Yeni bölüm düştüğünde etiketlenecek rol ID'si (boş bırakılırsa rol etiketlenmez):
ANNOUNCEMENT_ROLE_ID=
# Sitenin kontrol edilme sıklığı (dakika cinsinden, varsayılan: 5):
CHECK_INTERVAL_MINUTES=5

# 5. 🛡️ Moderasyon, Denetim Kayıtları & Karşılama
# Tüm yasaklama, atılma ve silinen mesajların iletileceği mod-log kanalı ID'si:
MOD_LOG_CHANNEL_ID=
# Yeni katılan üyelerin karşılanacağı kanal ID'si (boşsa karşılama mesajı atılmaz):
WELCOME_CHANNEL_ID=
# Yeni gelen üyelere otomatik verilecek rol ID'si (örn. Gölge Genin):
AUTO_ROLE_ID=
